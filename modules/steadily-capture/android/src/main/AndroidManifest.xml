<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    No INTERNET permission, on purpose: the capture layer never touches the network (D-011).
    Notification access is granted by the user in system settings, not through a manifest
    permission. WAKE_LOCK keeps the device awake while the Headless JS drain starts.
  -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <service
      android:name=".SteadilyNotificationListener"
      android:exported="true"
      android:label="Steadily"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!-- Runs the JS task "SteadilyCaptureDrain" after captures are staged. -->
    <service
      android:name=".CaptureDrainService"
      android:exported="false" />
  </application>
</manifest>
