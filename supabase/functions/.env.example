# Copy to supabase/functions/.env for `supabase functions serve` (never commit the copy).
# In production set these with `supabase secrets set`. Names only; no values here.

# Required secret
ANTHROPIC_API_KEY=

# Optional overrides (defaults in packages/proxy-core)
CLAUDE_CATEGORIZE_MODEL=
CLAUDE_ASK_MODEL=
PROXY_DAILY_CATEGORIZE_PER_USER=
PROXY_DAILY_ASK_PER_USER=
PROXY_DAILY_SPEND_CAP_USD=

# Provided automatically by Supabase in edge functions; do not set by hand:
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
