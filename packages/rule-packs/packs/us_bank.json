{
  "issuerId": "us_bank",
  "displayName": "U.S. Bank",
  "version": 2,
  "verified": false,
  "sources": {
    "androidPackages": ["com.usbank.mobilebanking"],
    "smsSenders": []
  },
  "exclude": [
    "declined",
    "not approved",
    "one-time (?:pass)?code",
    "(?:verification|security|sign-in|login|access) code",
    "Zelle"
  ],
  "rules": [
    {
      "id": "us_bank_card_used",
      "channel": "any",
      "direction": "debit",
      "pattern": "U\\.? ?S\\.? Bank[^:]*: (?:Your )?(?:debit |credit )?card ending (?:in )?(?<last4>[0-9]{4}) (?:was used for (?:an? )?|was charged )(?:\\$|USD ?)(?<amount>[0-9][0-9,]*(?:\\.[0-9]{1,2})?) (?:purchase |transaction )?(?:at|with) (?<merchant>.+?)(?: on (?<date>[0-9]{2}/[0-9]{2}(?:/[0-9]{2,4})?))?(?:\\.(?: .*)?)?$"
    },
    {
      "id": "us_bank_purchase",
      "channel": "any",
      "direction": "debit",
      "pattern": "U\\.? ?S\\.? Bank[^:]*: (?:A )?(?:debit |credit )?(?:card )?(?:purchase|transaction) of (?:\\$|USD ?)(?<amount>[0-9][0-9,]*(?:\\.[0-9]{1,2})?) (?:was made )?(?:at|with) (?<merchant>.+?)(?: (?:on|using) (?:your )?(?:debit |credit )?card ending (?:in )?(?<last4>[0-9]{4}))?(?:\\.(?: .*)?)?$"
    },
    {
      "id": "us_bank_refund",
      "channel": "any",
      "direction": "credit",
      "pattern": "U\\.? ?S\\.? Bank[^:]*: (?:A )?(?:refund|credit) of (?:\\$|USD ?)(?<amount>[0-9][0-9,]*(?:\\.[0-9]{1,2})?) from (?<merchant>.+?) (?:was|has been) (?:posted|credited|applied)[^.]*?(?:ending (?:in )?(?<last4>[0-9]{4}))?(?:\\.(?: .*)?)?$"
    },
    {
      "id": "us_bank_new_transaction",
      "channel": "any",
      "direction": "debit",
      "pattern": "Your U\\.? ?S\\.? Bank (?:credit|debit) card has a new transaction[^$]*? was charged (?:\\$|USD ?)(?<amount>[0-9][0-9,]*(?:\\.[0-9]{1,2})?) at (?<merchant>.+?)\\.(?: |$)(?:.*?ending in (?<last4>[0-9]{4}))?"
    },
    {
      "id": "us_bank_push_card_used",
      "channel": "push",
      "direction": "debit",
      "pattern": "^(?:Your )?(?:debit |credit )?card ending (?:in )?(?<last4>[0-9]{4}) (?:was used for (?:an? )?|was charged )(?:\\$|USD ?)(?<amount>[0-9][0-9,]*(?:\\.[0-9]{1,2})?) (?:purchase |transaction )?(?:at|with) (?<merchant>.+?)(?:\\.(?: .*)?)?$"
    }
  ]
}
